[Unit]
Description=Assistant vocal de tâches (bot Telegram)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=assistant
Group=assistant
WorkingDirectory=/opt/assistant-taches
EnvironmentFile=/opt/assistant-taches/.env
ExecStart=/opt/assistant-taches/.venv/bin/python -m assistant.main
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/assistant-taches/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
